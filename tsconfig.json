{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "allowJs": true,
        "composite": true,
        "strict": true,
        "jsx": "preserve",
        "moduleResolution": "node",
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true,
        "useDefineForClassFields": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "noEmit": true,
        "strictPropertyInitialization": false,
        "sourceMap": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "checkJs": true,
        "paths": {
            "three/addons/*": [
                "node_modules/@types/three/examples/jsm/*"
            ],
            "three/tsl": [
                "node_modules/@types/three/build/three.tsl.d.ts"
            ],
            "three/webgpu": [
                "node_modules/@types/three/build/three.webgpu.d.ts"
            ],
        },
        "lib": [
            "esnext",
            "dom", // Do not include dom cause of Node namespace collapse
            "dom.iterable", // Do not include dom cause of Node namespace collapse
            "scripthost"
        ],
        "types": [
            "@webgpu/types"
        ]
    },
    "include": [
        "src/**/*.js",
        "examples/**/*",
        "src/renderers/webgpu/utils/WebGPUConstants.ts",
    ],
    "exclude": [
        "node_modules/**/*",
        "build",
        "examples/jsm/libs/**/*"
    ]
}